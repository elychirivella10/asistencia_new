# ============================================================
# Sistema Biométrico & TAG — Environment Variables
# Copia este archivo como .env y ajusta los valores.
# ============================================================

# -----------------------------------------------------------
# Base de Datos (PostgreSQL + Prisma)
# -----------------------------------------------------------
DATABASE_URL="postgresql://<usuario>:<contraseña>@<host>:5432/<nombre_db>"

# -----------------------------------------------------------
# Dispositivo Biométrico (ZK)
# -----------------------------------------------------------
BIOMETRICO_IP="10.100.x.x"
BIOMETRICO_PORT=4370
KPI_DEBUG=0
DISPOSITIVO_ID="ZK_RELOJ_OFICINA_01"

# -----------------------------------------------------------
# Reglas de Asistencia
# -----------------------------------------------------------
HORA_ENTRADA_OFICIAL=08:00:00
MARGEN_TARDIA_MIN=10
# true → minutos esperados = 0 en caso de falta
# false → se mantiene el total del turno
MINUTOS_ESPERADOS_EN_FALTA_CERO=true

# -----------------------------------------------------------
# Depuración del Biométrico
# -----------------------------------------------------------
DIAS_PARA_DEPURAR=1500000000000
PATH_ULTIMA_LIMPIEZA="./logs/last_clear.txt"

# -----------------------------------------------------------
# Seguridad Web (Cookies)
# -----------------------------------------------------------
# false → permite login por HTTP (red local)
# true  → solo HTTPS (producción)
COOKIE_SECURE=false

# -----------------------------------------------------------
# Comedor
# -----------------------------------------------------------
COMEDOR_IP="10.100.x.x"
COMEDOR_PORT=4370
COMEDOR_DISPOSITIVO_ID="COMEDOR_01"
COMEDOR_DESCUENTA_MINUTOS=true
COMEDOR_MAX_SESSION_MIN=120
COMEDOR_MAX_DAILY_MIN=120

# -----------------------------------------------------------
# Correo (SMTP)
# -----------------------------------------------------------
SMTP_SERVER="<servidor_smtp>"
SMTP_PORT=587
SMTP_USER="<usuario_correo>"
SMTP_PASS="<contraseña_correo>"
SMTP_FROM="Asistencia Biométrica <asistencia@ejemplo.gob.ve>"
